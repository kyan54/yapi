{
  "name": "yapi-vendor",
  "version": "1.11.0",
  "description": "YAPI",
  "main": "server/app.js",
  "scripts": {
    "dev-copy-icon": "cp -r static/iconfont ./",
    "dev-server": " nodemon server/app.js dev -L",
    "install-server": " node server/install.js",
    "dev-client": "webpack serve --mode development",
    "dev": "npm run dev-server & npm run dev-client",
    "start": " node server/app.js",
    "test": "node --test --require ./scripts/test/register-legacy.js test/*.test.js test/common/*.test.js test/server/*.test.js",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "build-client": "webpack --mode production && node scripts/build/finalize.js",
    "npm-publish": "node ./npm-publish.js",
    "docs": "ydoc build",
    "test:modernization": "node --test test-modernization/*.test.js",
    "baseline:inventory": "node scripts/modernization/baseline.js",
    "mcp:docs": "node server/mcp/stdio.js"
  },
  "scripts-info": {
    "start": "运行生产环境服务器",
    "install-server": "初始化数据库数据，用于安装",
    "dev": "运行开发服务器",
    "dev-server": "运行后端开发服务器",
    "dev-client": "运行前端开发服务器",
    "test": "执行测试"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:YMFE/yapi.git"
  },
  "author": "",
  "license": "Apache-2.0",
